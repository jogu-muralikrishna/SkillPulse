# ---- SkillPulse environment (server-side only) ----
# Copy to .env for local use. On Vercel, set these in Project Settings -> Environment Variables.
# Never prefix these with VITE_ and never commit real values.

# Required for Gemini assistant, embeddings and semantic NCO matching.
GEMINI_API_KEY=your-gemini-api-key

# URL of the Python ML forecasting service (ml-service/). Local default shown.
# In production point this to your separately hosted service, e.g. https://your-ml-service.example.com
# If unreachable, /api/forecast falls back to the built-in OLS forecast.
ML_SERVICE_URL=http://127.0.0.1:8001

# Optional: override the Gemini chat model used by the assistant.
# GEMINI_MODEL=

# Optional: comma-separated browser origins allowed to call the API cross-origin.
# Leave unset when the frontend and API share one origin (default on Vercel).
# ALLOWED_ORIGINS=https://your-frontend.example.com
